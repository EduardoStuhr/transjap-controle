cat > .gitignore << 'EOF'
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependências e builds
node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
.cache/
.turbo/
.next/
.vercel/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Variáveis de ambiente
.env
.env.local
.env.*.local
.env.production
.env.development

# Credenciais e chaves
*.pem
*.key
*.cert
*.p12
*.pfx
credentials.json
secrets.json

# Bancos de dados locais e backups
*.sqlite
*.sqlite3
*.db
*.db-journal
backup-*.sql
dump-*.sql
.drizzle/

# Arquivos locais diversos
*.local

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
EOF
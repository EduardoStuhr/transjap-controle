<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/transjap_black</item>
        <item name="android:navigationBarColor">@color/transjap_black</item>
        <item name="android:windowBackground">@color/transjap_black</item>
        <item name="android:popupBackground">@color/transjap_surface</item>
        <item name="android:textColorPrimary">@color/transjap_text</item>
        <item name="android:textColorSecondary">@color/transjap_text_muted</item>
        <item name="android:colorForeground">@color/transjap_text</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:background">@color/transjap_black</item>
        <item name="android:windowBackground">@color/transjap_black</item>
        <item name="android:statusBarColor">@color/transjap_black</item>
        <item name="android:navigationBarColor">@color/transjap_black</item>
        <item name="android:popupBackground">@color/transjap_surface</item>
        <item name="android:textColorPrimary">@color/transjap_text</item>
        <item name="android:textColorSecondary">@color/transjap_text_muted</item>
        <item name="android:colorForeground">@color/transjap_text</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/transjap_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/transjap_black</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/transjap_black</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
